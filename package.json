{
  "name": "ai-cms",
  "private": true,
  "workspaces": [
    "system/server",
    "system/admin",
    "mcp"
  ],
  "scripts": {
    "start": "node server.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix system/server run dev",
    "dev:admin": "npm --prefix system/admin run dev",
    "dev:mcp": "npm --prefix mcp run dev",
    "build:admin": "npm --prefix system/admin run build",
    "build:site": "npm --prefix system/server run build:static",
    "db:init": "npm --prefix system/server run db:init",
    "admin:create": "npm --prefix system/server run admin:create --",
    "build:dist": "npm run build:admin && node scripts/build-dist.mjs",
    "build": "npm run build:dist"
  }
}
