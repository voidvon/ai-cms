{
  "name": "ai-cms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + SQLite server for the legacy static site migration.",
  "scripts": {
    "postinstall": "node ../../scripts/patch-openai-agents-core-status.mjs",
    "start": "node src/server.mjs",
    "dev": "node ../../scripts/dev-server.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:export-access": ".venv/bin/python scripts/export-access.py",
    "db:sync:home-meta": "node scripts/sync-spirax-global-home-meta.mjs",
    "db:sync:list-meta": "node scripts/sync-spirax-global-list-column-meta.mjs",
    "db:sync:content-meta": "node scripts/sync-spirax-global-content-meta.mjs",
    "db:sync:single-meta": "node scripts/sync-spirax-global-single-column-meta.mjs",
    "db:migrate:product-spec-options": "node scripts/migrate-product-spec-options-to-main-table.mjs",
    "db:fix:en-spec-options": "node scripts/fix-en-product-spec-options.mjs",
    "db:repair-encoding": "node scripts/repair-legacy-encoding.mjs --write",
    "admin:create": "node scripts/create-admin.mjs",
    "build:static": "node scripts/build-static.mjs",
    "test:system-updates": "node --test tests/system-updates.test.mjs",
    "test:data-tables": "node --test tests/data-tables.test.mjs",
    "test:smoke": "node tests/smoke/runtime-smoke.mjs",
    "test": "npm run test:system-updates && npm run test:data-tables && npm run test:smoke"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "@openai/agents": "^0.12.0",
    "ai": "^7.0.7",
    "esbuild": "^0.27.0",
    "fastify": "^5.8.5",
    "heic-convert": "^2.1.0",
    "lightningcss": "^1.32.0",
    "openai": "^6.45.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  }
}
