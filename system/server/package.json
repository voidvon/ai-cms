{
  "name": "spiraxsarcocn-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + SQLite server for the legacy static site migration.",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node ../..//scripts/dev-server.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:export-access": ".venv/bin/python scripts/export-access.py",
    "db:import": "node scripts/import-csv.mjs",
    "db:import:spirax-site": "node scripts/import-spirax-global-site-config.mjs",
    "db:import:spirax-templates": "node scripts/import-spirax-global-templates.mjs --select",
    "db:backfill-media": "node scripts/backfill-media-assets.mjs",
    "db:repair-encoding": "node scripts/repair-legacy-encoding.mjs --write",
    "admin:create": "node scripts/create-admin.mjs",
    "build:static": "node scripts/build-static.mjs && node scripts/patch-footer-products.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5"
  }
}
